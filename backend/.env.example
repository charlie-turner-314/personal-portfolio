# Database
DATABASE_URL=postgresql+psycopg://financeuser:financepass@localhost:5433/finance_db
# Production example:
# DATABASE_URL=postgresql+psycopg://financeuser:financepass@db:5432/finance_db?sslmode=require

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend / CORS
APP_URL=http://localhost:8080
# Optional explicit overrides (defaults derive from APP_URL in app code)
# FRONTEND_URL=http://localhost:8080
# CORS_ALLOW_ORIGINS=http://localhost:8080

# Optional toggles
API_DOCS_ENABLED=false
AUTO_CREATE_TABLES=false

# Optional integrations
OPENAI_API_KEY=
# Contextual classification (embeddings are optional and incur separate API usage)
CATEGORIZER_CONTEXT_ENABLED=false
# Opt-in review panel; requesting a suggestion never applies it automatically.
CATEGORIZER_SUGGESTIONS_ENABLED=false
CATEGORIZER_SUGGESTION_CONTEXT=examples_only
CATEGORIZATION_LLM_MODEL=gpt-4o-mini
# Local alternative: CATEGORIZER_PROVIDER=ollama and CATEGORIZATION_LLM_MODEL=qwen3:8b
CATEGORIZER_PROVIDER=openai
CATEGORIZER_OLLAMA_BASE_URL=http://127.0.0.1:11434
CATEGORIZER_OLLAMA_CONTEXT=32768
CATEGORIZER_OLLAMA_TIMEOUT=180
CATEGORIZER_EMBEDDING_MODEL=
# Absolute path to a user-attested, private snapshot (see CATEGORIZATION.md)
CATEGORIZER_VERIFIED_SNAPSHOT=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENVIRONMENT=sandbox
KRAKEN_API_KEY=
KRAKEN_PRIVATE_KEY=

# Enable Banking (Open Banking / PSD2)
# Sandbox vs production is determined by the app credentials, not a separate flag.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
# OR use a file path instead:
# ENABLE_BANKING_PRIVATE_KEY_PATH=/path/to/private-key.pem
ENABLE_BANKING_REDIRECT_URI=http://localhost:8080/api/enable-banking/callback

# Demo environment controls
# Enable only in dedicated demo deployments.
DEMO_MODE=false
# Shared demo account identity (provide one or both)
DEMO_SHARED_USER_EMAIL=
DEMO_SHARED_USER_ID=
# Nightly reset controls (UTC)
DEMO_RESET_ENABLED=false
DEMO_RESET_HOUR_UTC=0
# Daily transaction engine controls (adds previous-day demo transactions)
DEMO_DAILY_ENGINE_ENABLED=false
DEMO_DAILY_ENGINE_HOUR_UTC=2
DEMO_DAILY_ENGINE_MINUTE_UTC=15
# Deterministic random seed for demo data generation
DEMO_SEED_RANDOM_SEED=42

# Optional application-layer encryption (recommended for production).
# Use a 32-byte key encoded as base64 or hex.
# DATA_ENCRYPTION_KEY_CURRENT=
# DATA_ENCRYPTION_KEY_PREVIOUS=
# DATA_ENCRYPTION_KEY_ID=k1


# Internal app <-> backend auth (required)
# Shared secret with the frontend; HMAC-signs /internal/* and /api/* calls.
# Generate with: openssl rand -hex 32
INTERNAL_AUTH_SECRET=
# Frontend base URL used for backend-initiated callbacks/links.
FRONTEND_URL=http://localhost:3000
